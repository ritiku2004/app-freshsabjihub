{
  "expo": {
    "name": "Fresh Sabji Hub",
    "slug": "grocery-app",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/Logo/logo.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/Logo/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#15803D"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "LSApplicationQueriesSchemes": [
          "upi",
          "phonepe",
          "tez",
          "paytmmp",
          "bhim"
        ]
      }
    },
    "android": {
      "package": "com.ritik2004.groceryapp",
      "googleServicesFile": "./google-services.json",
      "navigationBar": {
        "backgroundColor": "#000000",
        "barStyle": "light-content"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "./withUpiQueries",
      "expo-notifications",
      "expo-sharing",
      "expo-image"
    ],
    "extra": {
      "eas": {
        "projectId": "45468e61-ffaf-4694-895e-9469db3ec53e"
      }
    },
    "owner": "helloworld15"
  }
}
